(
  ends_with(http.request.uri.path, ".env")
  or ends_with(http.request.uri.path, ".env.local")
  or ends_with(http.request.uri.path, ".env.production")
  or ends_with(http.request.uri.path, ".bak")
  or ends_with(http.request.uri.path, ".backup")
  or ends_with(http.request.uri.path, ".old")
  or ends_with(http.request.uri.path, ".swp")
  or ends_with(http.request.uri.path, ".tmp")
  or ends_with(http.request.uri.path, ".log")
  or ends_with(http.request.uri.path, ".sql")
  or ends_with(http.request.uri.path, ".dump")
  or ends_with(http.request.uri.path, ".pem")
  or ends_with(http.request.uri.path, ".key")
  or ends_with(http.request.uri.path, ".ini")
  or ends_with(http.request.uri.path, ".conf")
  or ends_with(http.request.uri.path, ".yml")
  or ends_with(http.request.uri.path, ".yaml")
  or ends_with(http.request.uri.path, ".htaccess")
  or ends_with(http.request.uri.path, ".htpasswd")
  or ends_with(http.request.uri.path, "phpinfo.php")
  or ends_with(http.request.uri.path, "composer.json")
  or ends_with(http.request.uri.path, "composer.lock")
  or http.request.uri.path contains "/.git/"
  or http.request.uri.path contains "/.env"
  or http.request.uri.path contains "/wp-config.php"
  or http.request.uri.path contains "/.ssh/"
  or http.request.uri.path eq "/server-status"
)
